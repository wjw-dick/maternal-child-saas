# ===== 运行环境 =====
SPRING_PROFILES_ACTIVE=mysql
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# ===== MySQL 8 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maternal_child
DB_USER=mc_saas
DB_PASSWORD=change-me

# ===== Redis =====
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ===== RabbitMQ =====
MQ_ENABLED=true
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=mc_saas
RABBIT_PASSWORD=change-me
MQ_EXCHANGE=mc.topic

# ===== 定时任务 =====
JOB_ENABLED=true
JOB_CRON=0 0 3 * * ?

# ===== SSO =====
# 生产必须 false；沙箱联调可临时 true
SSO_MOCK=false

# ===== 安全密钥 =====
JWT_SECRET=please-change-to-a-long-random-secret-at-least-32-chars
APP_CRYPTO_KEY=please-change-32-bytes-aes-key-000

# ===== 存储 =====
STORAGE_ROOT=/www/wwwroot/mc-saas/backend/data/storage

# ===== 默认租户 =====
DEFAULT_TENANT_CODE=demo

# ===== 备份 =====
BACKUP_DIR=/www/backup/mc-saas
BACKUP_KEEP=7
